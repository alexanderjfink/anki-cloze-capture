{
  "manifest_version": 2,
  "name": "Anki Cloze Capture",
  "version": "0.1.0",
  "description": "Highlight text on any page, generate Anki cloze cards with an LLM, and route them to the most relevant deck.",
  "browser_specific_settings": {
    "gecko": {
      "id": "anki-cloze-capture@local",
      "strict_min_version": "102.0"
    }
  },
  "permissions": [
    "storage",
    "menus",
    "notifications",
    "activeTab",
    "alarms",
    "unlimitedStorage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Anki Cloze Capture",
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png"
    }
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "capture-cloze": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Create an Anki cloze card from the current selection"
    },
    "toggle-edit": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Toggle edit mode / open the review board"
    },
    "toggle-markers": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Toggle page markers"
    },
    "autogen-page": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Generate the most useful cards from the whole page"
    }
  }
}
